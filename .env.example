# Kaagaz settings. LAPTOP ONLY: every key and password below is a local
# placeholder, never a real secret. Copy this file to .env and adjust:
#   cp .env.example .env                 (bash)
#   Copy-Item .env.example .env          (PowerShell)
# Never commit .env. backend/kaagaz/settings.py reads the app settings below;
# a missing one stops the process at start-up with its name. POSTGRES_*,
# AWS_* and DOCKER_MODEL_BASE_URL are for Docker and boto3, not settings.py.
#
# These values run the API and worker on the laptop itself (localhost).
# docker-compose.yml swaps in the service names (postgres, seaweedfs,
# elasticmq, clamav) for the containers.
#
# PROVISIONAL marks a value that is Vrushit's to decide (PRD section 6).

# --- Database -----------------------------------------------------------------
# The postgres service in docker-compose.yml (laptop-only password).
POSTGRES_USER=kaagaz
POSTGRES_PASSWORD=kaagaz
POSTGRES_DB=kaagaz
# How the backend connects. Laptop only; in AWS it comes from the secret store.
DATABASE_URL=postgresql://kaagaz:kaagaz@localhost:5432/kaagaz
# The restricted role every transaction switches to (made by the migration).
DB_APP_ROLE=kaagaz_app
# The limited logins (#479, migration 0067), on the server only: the API's and the
# workers' (kaagaz_api; read by docker-compose.yml only, as their DATABASE_URL), and the
# API's super admin part's (kaagaz_ops), each
# postgresql://<login>:<password>@postgres:5432/<POSTGRES_DB>. Empty, each is DATABASE_URL.
# Their passwords are set by hand (docs/running-locally.md, "Limited database logins").
APP_DATABASE_URL='postgresql://kaagaz:kaagaz@localhost:5432/kaagaz'
OPS_DATABASE_URL='postgresql://kaagaz:kaagaz@localhost:5432/kaagaz'
# The workers' own login (kaagaz_jobs, #587, migration 0083), on the server only, the same
# shape; read by docker-compose.yml only, as the worker's DATABASE_URL, and it sets the worker's
# DB_WORKER_ROLE to kaagaz_worker with it. Empty: the workers keep APP_DATABASE_URL.
JOBS_DATABASE_URL=
# The role the worker and the CLI switch to; empty: DB_APP_ROLE. Leave it empty in .env.
DB_WORKER_ROLE=
# The off-server backup's S3 bucket (read by infra/ec2/pgdump.sh only); empty: the dump stays on the server.
BACKUP_BUCKET=
# The certificate pgdump.sh seals each backup's key to, e.g. /home/ubuntu/kaagaz-secrets/backup-cert.pem.
BACKUP_CERT=

# --- File storage: SeaweedFS on the laptop, Amazon S3 in AWS -------------------
# Leave STORAGE_ENDPOINT_URL empty in AWS.
STORAGE_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# SeaweedFS ignores the region; in AWS it is ap-south-1.
STORAGE_REGION=ap-south-1
# Made on first start if missing (the migrate container, or the worker).
STORAGE_BUCKET=kaagaz-prod-files
# Laptop-only keys; they must match infra/seaweedfs/s3.json. Leave both empty
# in AWS, where the task role gives access.
#STORAGE_ACCESS_KEY=kaagaz-local
#STORAGE_SECRET_KEY=kaagaz-local-secret-laptop-only

# --- Queue: ElasticMQ on the laptop, Amazon SQS in AWS -------------------------
# In AWS leave QUEUE_ENDPOINT_URL empty: boto3 then reaches real SQS in
# QUEUE_REGION, and the instance role gives access (no keys).
QUEUE_ENDPOINT_URL=
# The failure bin is this URL plus "-failed" (infra/elasticmq/elasticmq.conf, and
# the SQS redrive rule). In AWS, with the account id:
QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/371892039688/kaagaz-jobs
QUEUE_EXPRESS_URL=https://sqs.ap-south-1.amazonaws.com/371892039688/kaagaz-jobs-express
EXPRESS_MAX_PAGES=3
# ElasticMQ ignores the region; in AWS it is ap-south-1.
QUEUE_REGION=ap-south-1
# PROVISIONAL: how long a job stays hidden while a worker runs it (1 to 43200).
# At least OCR_TIMEOUT_SECONDS + 135 and 2 x MODEL_EXTRACT_TIMEOUT_SECONDS + 75
# (each with the 15 s the worker may wait to renew a lease),
# or the worker refuses to start. Starting
# value (PRD 2 Lead's resolution 5): measure with cli measure.
QUEUE_LEASE_SECONDS=1200
# PROVISIONAL: how long an idle worker waits on the queue per ask (1 to 20).
QUEUE_WAIT_SECONDS=20
# How many times a job is tried before its document is marked failed
# (retries_exhausted). The queue's own maxReceiveCount must be above this + 1
# (infra/elasticmq/elasticmq.conf is 10), or the worker refuses to start.
JOB_MAX_ATTEMPTS=5
# boto3's own variables, for ElasticMQ only: it accepts any values but boto3
# needs some. Laptop only; never set these in AWS (the task role is used).
#AWS_ACCESS_KEY_ID=laptop-only-elasticmq
#AWS_SECRET_ACCESS_KEY=laptop-only-elasticmq

# --- Virus scanner ---------------------------------------------------------------
# clamav: clamd over TCP (the clamav service). eicar_dev: LAPTOP ONLY, finds
# the EICAR test file and nothing else; never use it with real files.
SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# PROVISIONAL: a scan of a 50 MB file must fit in this.
SCANNER_TIMEOUT_SECONDS=120

# --- Upload limits ---------------------------------------------------------------
# PROVISIONAL: the platform limit, which is also the PDF limit; an admin can set
# a lower one per customer, which lowers every type's limit below.
MAX_UPLOAD_MB=100
# Photos and scans (png, jpeg, tiff), and spreadsheets (xlsx, csv).
MAX_IMAGE_MB=20
MAX_SHEET_MB=10
# Types found from the first bytes: zip is .xlsx, .docx, .dotx or .pptx (or a zip to unpack),
# ole2 is .xls, .doc or .ppt (both at the PDF limit until the worker tells which), text is .csv,
# .txt, .md, .json or .html (the name chooses, #522), heic a HEIC or HEIF photo.
ALLOWED_TYPES=pdf,png,jpeg,tiff,heic,zip,text,ole2

# --- Reader limits (all PROVISIONAL) ---------------------------------------------
CSV_MAX_CELLS=1000000
XLSX_MAX_ENTRIES=1000
XLSX_MAX_MEMBER_BYTES=50000000
XLSX_MAX_TOTAL_BYTES=200000000
XLSX_MAX_CELLS=1000000
XLSX_MAX_TEXT_CHARS=50000000
MAX_PAGES=100
# Page pictures for the viewer (stored). OCR draws its pages at OCR_DPI instead.
PAGE_IMAGE_DPI=150
MAX_IMAGE_PIXELS=40000000

# --- Scan reader -----------------------------------------------------------------
# paddleocr_vl (the ocr container: `--profile paddle`), rapidocr, or none (scans
# and photos are then marked "can't be read yet"). Decided 30 Sep 2026: rapidocr
# on laptops (PaddleOCR-VL takes 3 to 11 minutes a page on a laptop CPU);
# paddleocr_vl on a GPU or demo machine, for Hindi and Marathi scans.
OCR_ENGINE=gemini
# Where the ocr container answers; docker-compose.yml sets http://ocr:8080 inside Docker.
# One page's OCR must finish in this: 5 minutes (decided 30 Sep 2026).
# PaddleOCR-VL took 178 to 653 seconds a page on a 4-core laptop CPU, so on a
# laptop keep OCR_ENGINE=rapidocr; PaddleOCR-VL is for a GPU or a demo machine.
OCR_TIMEOUT_SECONDS=120
# OCR pages are drawn at this DPI in memory and never stored (PRD 2 R5).
OCR_DPI=300

# --- Page route (PRD 2 R2 to R4) -----------------------------------------------
# Starting values (PRD 2 section 8): measure on the sample documents with
# `python -m kaagaz.cli measure --file <path>`, and record any change in
# docs/architecture.md.
# A PDF page keeps its text layer only with at least this many letters and digits...
TEXT_LAYER_MIN_CHARS=40
# ...and at least this share (0 to 1) of good characters; otherwise it goes to OCR.
TEXT_LAYER_MIN_GOOD_RATIO=0.9
# A page where one image covers more than this share (0 to 1) and the text is
# short is a scan with a typed footer: it goes to OCR.
SCAN_IMAGE_COVERAGE=0.5
# A picture whose grey spread is under this (and with almost no dark ink) is
# blank: it is never sent to OCR.
BLANK_PAGE_STDDEV=3.0
# A page under this DPI is flagged low resolution (never refused).
LOW_RES_DPI=150

# --- Local AI (Ollama) -----------------------------------------------------------
# false runs everything with no AI: search without meaning vectors, answers
# quote the evidence. Set true to use the models below through OpenRouter
# (then OPENROUTER_API_KEY is needed and each model must be a google/gemini- ID).
MODEL_ENABLED=true
# Decided 30 Sep 2026: one Qwen3.5 4B model reads text and images (3.4 GB,
# Apache-2.0). It needs Ollama 0.17.7 or later; docker-compose.yml runs 0.34.4.
# Pull both: ollama pull qwen3.5:4b and ollama pull qwen3-embedding:0.6b
MODEL_CHAT=google/gemini-3.5-flash-lite
MODEL_EMBED=google/gemini-embedding-2
# The second reading of each scanned value, from its cropped box: the same
# model, which reads images. Leave empty for none.
# MODEL_VISION=qwen3.5:4b
# Must match the vector(1024) column in the migration and MODEL_EMBED's size.
EMBEDDING_DIM=1024
# The timeout for one other model call (one embedding batch, one vision crop, an
# answer). This + 75 must not be more than QUEUE_LEASE_SECONDS.
MODEL_TIMEOUT_SECONDS=60
# Model budgets (PRD 2). Starting values: measure on the sample documents.
# The context window sent with every call, in tokens.
# MODEL_NUM_CTX=8192
# The longest reply for the document card, for each invoice window and for an
# answer, in tokens. MODEL_NUM_CTX - 2 x each (a reply and its one repair) -
# 1100 (the prompt and the chat template) must leave at least 1024 for the document.
MODEL_CARD_MAX_TOKENS=1024
MODEL_WINDOW_MAX_TOKENS=2048
# PROVISIONAL: an answer has at most 5 sentences of 300 characters (about 450
# window with it is left out, lowest-ranked pieces first, whole.
MODEL_ANSWER_MAX_TOKENS=2048
# The worker's timeout for one card or invoice call. 2 x this + 75 must not be
# more than QUEUE_LEASE_SECONDS.
MODEL_EXTRACT_TIMEOUT_SECONDS=300
# The document card reads at most this many characters of the document.
CARD_MAX_CHARS=12000
# An invoice is read in windows (PRD 2 E2): this many characters each, each
# overlapping the one before by EXTRACT_WINDOW_OVERLAP (less than
# EXTRACT_WINDOW_CHARS, or nothing starts), at most EXTRACT_MAX_WINDOWS of them;
# text past the last window is skipped and the invoice check says "truncated".
# A window's reply needs about 50 tokens for every 50 characters of it, plus 300,
# within MODEL_WINDOW_MAX_TOKENS, or nothing starts.
# Leave both empty to size them from MODEL_WINDOW_MAX_TOKENS: 2048 gives 1700
# and 400 (decided 30 Sep 2026). A bigger model only needs a larger
# MODEL_WINDOW_MAX_TOKENS (and MODEL_NUM_CTX); the windows grow with it. Set them
# only to override that, for a measured reason.
EXTRACT_WINDOW_CHARS=
EXTRACT_WINDOW_OVERLAP=
EXTRACT_MAX_WINDOWS=10
# Docker only (not a backend setting): where the containers find Ollama.
# Empty means Ollama on the laptop (host.docker.internal). With
# `--profile ollama`, set it to http://ollama:11434.
# DOCKER_MODEL_BASE_URL=http://ollama:11434

# --- Sign-in ---------------------------------------------------------------------
# REPLACE THIS. At least 32 random characters; the placeholder is too short on
# purpose, so nothing starts until you do. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me
# PROVISIONAL: how long a sign-in lasts.
SESSION_HOURS=12
# false on the laptop (plain http); true anywhere with https.
COOKIE_SECURE=true
# REPLACE THIS. Encrypts the admins' two-step (TOTP) secrets. At least 32
# random characters, and not the same as SESSION_SECRET. The placeholder is too
# short on purpose, so nothing starts until you set it. Make one the same way:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later makes every enrolled admin enrol again (reset their 2FA).
TOTP_ENCRYPTION_KEY=replace-me
# Lockout: this many wrong sign-ins in a row locks the account for
# LOGIN_LOCK_MINUTES. An admin can unlock it sooner.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# How long an admin sign-in (at /admin/login) lasts.
ADMIN_SESSION_MINUTES=60
# true: anyone may create an organisation and its first admin at /signup (at most 20 an hour
# for the whole site behind the proxy; no e-mail is proven yet). Off unless true: the page is
# off and the sign-in pages hide its link.
SELF_SIGNUP_ENABLED=false

# --- Email (#457 phase 0) ----------------------------------------------------------
# true: Kaagaz sends email through Amazon SES (confirm your email, invites, forgotten
# passwords, security notices) and a password sign-up waits for an operator's approval.
# Off unless true: every email route is 404 and nothing is sent. On, EMAIL_FROM (the
# verified sending address) and APP_URL (the https origin the links open) are required.
EMAIL_ENABLED=false
EMAIL_FROM=
SES_REGION=ap-south-1
APP_URL=
# Where operations alerts go (the super admin's address): an organisation's reading paused at
# its daily page limit or budget (#478) and the server's disk alert (#480), both from
# EMAIL_FROM, with EMAIL_ENABLED on or off (backend/kaagaz/ops_alert.py). Empty: none is sent.
OPS_ALERT_EMAIL=


# --- Google Analytics (#457 phase 4) ----------------------------------------------
# A GA4 measurement id ("G-" then letters and digits): Google Analytics on three public pages
# only (sign-in, except its two-step code step; sign-up; forgot password), never on the reset
# password, invite or confirm email pages, never inside the app, and only after the visitor
# presses Accept. It sends the page path (no query string,
# no fragment) and a fixed title, nothing typed and no ids. Unset, empty or any other shape:
# no banner, no script. Read when the frontend is built (docker compose passes it). The
# test server leaves it empty. Commented out: only the frontend reads it, not the backend.
# NEXT_PUBLIC_GA_ID=

# --- Trash -----------------------------------------------------------------------
# Days a document stays in Trash before the worker deletes it for good (PRD 1 F5).
TRASH_DAYS=30

# --- Read again (PRD 2 X1) -------------------------------------------------------
# PROVISIONAL (security A8): how many documents a customer may send to be read
# again in one hour. One document can be read again at most once in 10 minutes.
REPROCESS_PER_HOUR=20

# --- Answers (PROVISIONAL) -------------------------------------------------------
# How many pieces of evidence an answer may look at.
ANSWER_MAX_EVIDENCE=8
# The lowest match score that still counts as evidence (0 to 1).
ANSWER_MIN_EVIDENCE_SCORE=0.2
# "Last month" and "this year" are worked out in this time zone.
TIMEZONE=Asia/Kolkata

# --- API -------------------------------------------------------------------------
# PROVISIONAL: requests per minute per user (per IP before sign-in).
RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=INFO

# --- Search (PRD 3 V2, PROVISIONAL) ---------------------------------------------
# hnsw.ef_search: how many candidates the meaning index keeps while it walks
# (1 to 1000). Higher finds more of the true nearest pieces, slower.
SEARCH_EF=100

# Search inside documents (PRD 3 Q2): at most this many documents in one
# GET /api/search reply, 1 to 100.
SEARCH_MAX_DOCUMENTS=20

# Answers (PRD 3 Q4): the pieces on each side of an evidence piece also given to the draft, 0 to 3.
ANSWER_NEIGHBOURS=1
# Chat (PRD 3 H1): the question and answer pairs a follow-up is rewritten with, 0 (no rewrite) to 10.
CHAT_HISTORY_TURNS=3
KAAGAZ_DOMAIN=replace-me
ACME_EMAIL=replace-me
SEAWEEDFS_S3_CONFIG=/home/ubuntu/kaagaz-secrets/s3.json

ANSWER_TRANSLATE_QUESTION=true

# Added from .env.example on 2026-10-30 (testing-env switch)
ANSWER_PARTS_MAX=5
ANSWER_PARTS_TOKENS=24000
ANSWER_PLAN_TIMEOUT_SECONDS=4
ANSWER_SWIFT_INPUT_TOKENS=30000
ANSWER_WHOLE_DOC_TOKENS=120000
CAREFUL_EARLY_MAX_PAGES=0
CHAT_QUESTIONS_PER_MINUTE=20
CHAT_SUMMARY_EVERY=6
COST_SAVING_CROP_PAD=0.5
COST_SAVING_HARD_LINES_MAX=12
COST_SAVING_HARD_SHARE=0.4
CPU_WORKERS=2
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=900
DB_LOCK_TIMEOUT_SECONDS=60
DB_STATEMENT_TIMEOUT_SECONDS=120
DB_WORKER_LOCK_TIMEOUT_SECONDS=300
DB_WORKER_STATEMENT_TIMEOUT_SECONDS=900
EXPRESS_MAX_PAGES=3
MAX_ACTIVE_PER_CUSTOMER=3
MAX_CHECK_CROPS=200
MAX_FILES_PER_BATCH=100
MODEL_CONTEXT_TOKENS=200000
MODEL_RPM=1200
MODEL_TRANSLATE_TIMEOUT_SECONDS=20
OCR_DPI_RULE=fixed
OCR_MEDIA_RESOLUTION=high
OCR_MODEL=google/gemini-3.5-flash-lite
OCR_PAGE_CONCURRENCY=8
OCR_RETRY_MEDIA_RESOLUTION=high
OCR_RETRY_THINKING_LEVEL=high
OCR_SECONDS_PER_PAGE=60
OCR_THINKING_LEVEL=low
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_VENDORS=google,anthropic,qwen,meta-llama,openai
OPENROUTER_PROVIDERS=google-vertex,azure
PAGE_ROUTE_CLEAN_CONFIDENCE=0.95
PAGE_ROUTE_HEIGHT_SPREAD=0.45
PAGE_ROUTE_MIN_LINE_PX=16
PAGE_ROUTE_MIN_WORDS=8
PAGE_ROUTE_REGION_LINES_MAX=6
PAGE_ROUTE_REGION_PAGES_MAX=25
PAGE_ROUTE_REGION_SHARE=0.15
PAGE_ROUTE_TABLE_SHARE=0.3
PAGE_ROUTING=true
QUERY_ASPECTS_MAX=6
READER_OUTAGE_FALLBACK_MINUTES=15
SELF_SIGNUP_ENABLED=false
TOPIC_EXPAND_MAX_PIECES=12
TOPIC_MAX_PER_DOC=40
OPENROUTER_API_KEY=replace-me
MISTRAL_ZDR_APPROVED=true
MISTRAL_API_KEY=replace-me

GOOGLE_SIGNIN_ENABLED=true
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://kaagaz.monoedge.in/api/auth/oidc/google/callback
NEXT_PUBLIC_GA_ID=G-WQZ8HGVQ5W

# STORAGE_ADMIN_ACCESS_KEY=cac2e9825d79e900f1374f563cfea073
# STORAGE_ADMIN_SECRET_KEY=44f74a4c1e25074396867408dddabbd664c28192cf008f35c9cd5e1900b49f2f
EMAIL_FROM=

ALLOWED_TYPES=pdf,png,jpeg,tiff,heic,zip,text,ole2
