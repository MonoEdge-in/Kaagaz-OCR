# Kaagaz settings. LAPTOP ONLY: every key and password below is a local
# placeholder, never a real secret. Copy this file to .env and adjust:
#   cp .env.example .env                 (bash)
#   Copy-Item .env.example .env          (PowerShell)
# Never commit .env. backend/kaagaz/settings.py reads the app settings below;
# a missing one stops the process at start-up with its name. POSTGRES_*,
# STORAGE_ADMIN_* and AWS_* are for Docker and boto3, not settings.py.
#
# These values run the API and worker on the laptop itself (localhost).
# docker-compose.yml swaps in the service names (postgres, seaweedfs,
# elasticmq, clamav) for the containers.
#
# PROVISIONAL marks a value that is Vrushit's to decide (PRD section 6).

# --- Database -----------------------------------------------------------------
# The postgres service in docker-compose.yml (laptop-only password).
POSTGRES_USER=kaagaz
POSTGRES_PASSWORD=kaagaz
POSTGRES_DB=kaagaz
# How the backend connects. Laptop only; in AWS it comes from the secret store.
DATABASE_URL=postgresql://kaagaz:kaagaz@localhost:5432/kaagaz
# The restricted role every transaction switches to (made by the migration).
DB_APP_ROLE=kaagaz_app
# The limited logins (#479, migration 0067), on the server only: the API's and the
# workers' (kaagaz_api), and the API's super admin part's (kaagaz_ops), each
# postgresql://<login>:<password>@postgres:5432/<POSTGRES_DB>. Empty, each is DATABASE_URL.
# Their passwords are set by hand (docs/running-locally.md, "Limited database logins").
APP_DATABASE_URL=
OPS_DATABASE_URL=
# PostgreSQL timeouts in seconds (#246 A1, PROVISIONAL; 0 is no limit). Optional: unset
# is the value here. The API's statements and lock waits, then the worker's (long on
# purpose: a cut save hands the job back to be read again), then how long any session may
# sit idle inside a transaction before PostgreSQL ends it. The CLI and migrations set none.
DB_STATEMENT_TIMEOUT_SECONDS=120
DB_LOCK_TIMEOUT_SECONDS=60
DB_WORKER_STATEMENT_TIMEOUT_SECONDS=900
DB_WORKER_LOCK_TIMEOUT_SECONDS=300
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=900

# --- File storage: SeaweedFS on the laptop, Amazon S3 in AWS -------------------
# Leave STORAGE_ENDPOINT_URL empty in AWS.
STORAGE_ENDPOINT_URL=http://localhost:8333
# SeaweedFS ignores the region; in AWS it is ap-south-1.
STORAGE_REGION=us-east-1
# Made on first start if missing, by the migrate container with the admin key.
STORAGE_BUCKET=kaagaz-local
# Laptop-only keys; they must match infra/seaweedfs/s3.json. Leave both empty
# in AWS, where the task role gives access.
STORAGE_ACCESS_KEY=kaagaz-local
STORAGE_SECRET_KEY=kaagaz-local-secret-laptop-only
# The storage admin key, migrate's alone (#477): the app's key above may only read,
# write and list its own bucket, so migrate creates the bucket with this one. Read by
# docker-compose.yml; laptop-only, it must match infra/seaweedfs/s3.json's admin identity.
STORAGE_ADMIN_ACCESS_KEY=kaagaz-local-admin
STORAGE_ADMIN_SECRET_KEY=kaagaz-local-admin-secret-laptop-only

# --- Queue: ElasticMQ on the laptop, Amazon SQS in AWS -------------------------
# Leave QUEUE_ENDPOINT_URL empty in AWS.
QUEUE_ENDPOINT_URL=http://localhost:9324
# The failure bin is this URL plus "-failed" (infra/elasticmq/elasticmq.conf).
QUEUE_URL=http://localhost:9324/000000000000/kaagaz-jobs
QUEUE_REGION=us-east-1
# PROVISIONAL: how long a job stays hidden while a worker runs it (1 to 43200).
# At least OCR_TIMEOUT_SECONDS + 135 and 2 x MODEL_EXTRACT_TIMEOUT_SECONDS + 75
# (each with the 15 s the worker may wait to renew a lease),
# or the worker refuses to start. Starting
# value (PRD 2 Lead's resolution 5): measure with cli measure.
QUEUE_LEASE_SECONDS=1200
# PROVISIONAL: how long an idle worker waits on the queue per ask (1 to 20).
QUEUE_WAIT_SECONDS=20
# How many times a job is tried before its document is marked failed
# (retries_exhausted). The queue's own maxReceiveCount must be above this + 1
# (infra/elasticmq/elasticmq.conf is 10), or the worker refuses to start.
JOB_MAX_ATTEMPTS=5
# boto3's own variables, for ElasticMQ only: it accepts any values but boto3
# needs some. Laptop only; never set these in AWS (the task role is used).
AWS_ACCESS_KEY_ID=laptop-only-elasticmq
AWS_SECRET_ACCESS_KEY=laptop-only-elasticmq

# --- Virus scanner ---------------------------------------------------------------
# clamav: clamd over TCP (the clamav service). eicar_dev: LAPTOP ONLY, finds
# the EICAR test file and nothing else; never use it with real files.
SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# PROVISIONAL: a scan of a 50 MB file must fit in this.
SCANNER_TIMEOUT_SECONDS=120

# --- Upload limits ---------------------------------------------------------------
# PROVISIONAL: the platform limit, which is also the PDF limit; an admin can set
# a lower one per customer, which lowers every type's limit below.
MAX_UPLOAD_MB=50
# Photos and scans (png, jpeg, tiff), and spreadsheets (xlsx, csv).
MAX_IMAGE_MB=20
MAX_SHEET_MB=10
# Types found from the first bytes: zip is .xlsx, text is .csv. Each needs a
# limit above, so ole2 (old .xls and .doc) cannot be listed.
ALLOWED_TYPES=pdf,png,jpeg,tiff,zip,text

# --- Reader limits (all PROVISIONAL) ---------------------------------------------
CSV_MAX_CELLS=1000000
XLSX_MAX_ENTRIES=1000
XLSX_MAX_MEMBER_BYTES=50000000
XLSX_MAX_TOTAL_BYTES=200000000
XLSX_MAX_CELLS=1000000
XLSX_MAX_TEXT_CHARS=50000000
MAX_PAGES=100
# Page pictures for the viewer (stored). OCR draws its pages at OCR_DPI instead.
PAGE_IMAGE_DPI=150
MAX_IMAGE_PIXELS=40000000

# --- Scan reader -----------------------------------------------------------------
# gemini (every scanned page read by OCR_MODEL through OpenRouter; needs
# OPENROUTER_API_KEY), rapidocr (on the CPU, no key: laptops and CI), or none
# (scans and photos are then marked "can't be read yet").
OCR_ENGINE=rapidocr
# One page's read must finish in this, at most (Tushar, 16 Oct 2026: 60 s a page): every call
# for the page, a cut-off page's halves and a low read started alongside a slow high one
# included. A page past it is read locally and needs review.
OCR_TIMEOUT_SECONDS=60
# OCR pages are drawn at this DPI in memory and never stored (PRD 2 R5).
OCR_DPI=300

# --- Page route (PRD 2 R2 to R4) -----------------------------------------------
# Starting values (PRD 2 section 8): measure on the sample documents with
# `python -m kaagaz.cli measure --file <path>`, and record any change in
# docs/architecture.md.
# A PDF page keeps its text layer only with at least this many letters and digits...
TEXT_LAYER_MIN_CHARS=40
# ...and at least this share (0 to 1) of good characters; otherwise it goes to OCR.
TEXT_LAYER_MIN_GOOD_RATIO=0.9
# A page where one image covers more than this share (0 to 1) and the text is
# short is a scan with a typed footer: it goes to OCR.
SCAN_IMAGE_COVERAGE=0.5
# A picture whose grey spread is under this (and with almost no dark ink) is
# blank: it is never sent to OCR.
BLANK_PAGE_STDDEV=3.0
# A page under this DPI is flagged low resolution (never refused).
LOW_RES_DPI=150

# --- AI ---------------------------------------------------------------------------
# false runs everything with no AI: search without meaning vectors, answers
# quote the evidence. Set true to use the models below through OpenRouter
# (then OPENROUTER_API_KEY is needed and each model must be a google/gemini- ID).
MODEL_ENABLED=false
# PRD 5 via OpenRouter (council 8 Oct 2026): Gemini handles chat, scan reading
# and embeddings. Unset, MODEL_CHAT and OCR_MODEL are Gemini 3.8 Flash (16 Oct 2026); the
# super admin's settings, when saved, choose instead.
MODEL_CHAT=google/gemini-3.8-flash
MODEL_EMBED=google/gemini-embedding-2
# Must match the vector(1024) column in the migration and MODEL_EMBED's size.
EMBEDDING_DIM=1024
# The timeout for one other model call (one embedding batch, an answer).
# This + 75 must not be more than QUEUE_LEASE_SECONDS.
MODEL_TIMEOUT_SECONDS=60
# Model budgets (PRD 2, PRD 5 M1). Starting values: measure on the sample documents.
# The longest reply for the document card, in tokens.
MODEL_CARD_MAX_TOKENS=1024
# PROVISIONAL: the answer's JSON reply; set it from a measured p99 reply. 512 cut off a
# list answer on the server (24 Oct 2026, "jalna lands"), so 2048. Evidence that would not
# fit the window with it is left out, lowest-ranked pieces first, whole.
MODEL_ANSWER_MAX_TOKENS=2048
# The worker's timeout for one card or invoice call. 2 x this + 75 must not be
# more than QUEUE_LEASE_SECONDS.
MODEL_EXTRACT_TIMEOUT_SECONDS=300
# The document card reads at most this many characters of the document.
CARD_MAX_CHARS=12000
# An invoice is read in windows (PRD 2 E2): this many characters each, each
# overlapping the one before by EXTRACT_WINDOW_OVERLAP (less than
# EXTRACT_WINDOW_CHARS, or nothing starts), at most EXTRACT_MAX_WINDOWS of them;
# text past the last window is skipped and the invoice check says "truncated".
# Each window's reply is capped at 2048 tokens, which fits windows of at most
# 1700 characters. Leave both empty for 1700 and 400 (decided 30 Sep 2026); set
# them only to override that, for a measured reason.
EXTRACT_WINDOW_CHARS=
EXTRACT_WINDOW_OVERLAP=
EXTRACT_MAX_WINDOWS=10

# --- Sign-in ---------------------------------------------------------------------
# REPLACE THIS. At least 32 random characters; the placeholder is too short on
# purpose, so nothing starts until you do. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me
# PROVISIONAL: how long a sign-in lasts.
SESSION_HOURS=12
# false on the laptop (plain http); true anywhere with https.
COOKIE_SECURE=false
# REPLACE THIS. Encrypts the admins' two-step (TOTP) secrets. At least 32
# random characters, and not the same as SESSION_SECRET. The placeholder is too
# short on purpose, so nothing starts until you set it. Make one the same way:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later makes every enrolled admin enrol again (reset their 2FA).
TOTP_ENCRYPTION_KEY=replace-me
# Lockout: this many wrong sign-ins in a row locks the account for
# LOGIN_LOCK_MINUTES. An admin can unlock it sooner.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# How long an admin sign-in (at /admin/login) lasts.
ADMIN_SESSION_MINUTES=60
# true: anyone may create an organisation and its first admin at /signup (at most 20 an hour
# for the whole site behind the proxy; no e-mail is proven yet). Off unless true: the page is
# off and the sign-in pages hide its link.
SELF_SIGNUP_ENABLED=false

# --- Email (#457 phase 0) ----------------------------------------------------------
# true: Kaagaz sends email through Amazon SES (confirm your email, invites, forgotten
# passwords, security notices) and a password sign-up waits for an operator's approval.
# Off unless true: every email route is 404 and nothing is sent. On, EMAIL_FROM (the
# verified sending address) and APP_URL (the https origin the links open) are required.
EMAIL_ENABLED=false
EMAIL_FROM=
SES_REGION=ap-south-1
APP_URL=
# Where operations alerts go (the super admin's address): an organisation's reading paused at
# its daily page limit or budget (#478) and the server's disk alert (#480), both from
# EMAIL_FROM, with EMAIL_ENABLED on or off (backend/kaagaz/ops_alert.py). Empty: none is sent.
OPS_ALERT_EMAIL=

# --- Google sign-in (#457 phase 1) -------------------------------------------------
# true: "Continue with Google" on the sign-in page, and people connect a Google account
# under Account, Ways to sign in. Off unless true: every /api/auth/oidc/google route is 404.
# On, the three below are required: the OAuth client from Google Cloud (the secret only
# here, never logged) and its redirect URI, https and ending /api/auth/oidc/google/callback.
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Google Analytics (#457 phase 4) ----------------------------------------------
# A GA4 measurement id ("G-" then letters and digits): Google Analytics on three public pages
# only (sign-in, except its two-step code step; sign-up; forgot password), never on the reset
# password, invite or confirm email pages, never inside the app, and only after the visitor
# presses Accept. It sends the page path (no query string,
# no fragment) and a fixed title, nothing typed and no ids. Unset, empty or any other shape:
# no banner, no script. Read when the frontend is built (docker compose passes it). The
# test server leaves it empty. Commented out: only the frontend reads it, not the backend.
# NEXT_PUBLIC_GA_ID=

# --- Trash -----------------------------------------------------------------------
# Days a document stays in Trash before the worker deletes it for good (PRD 1 F5).
TRASH_DAYS=30

# --- Read again (PRD 2 X1) -------------------------------------------------------
# PROVISIONAL (security A8): how many documents a customer may send to be read
# again in one hour. One document can be read again at most once in 10 minutes.
REPROCESS_PER_HOUR=20

# --- Answers (PROVISIONAL) -------------------------------------------------------
# How many pieces of evidence an answer may look at.
ANSWER_MAX_EVIDENCE=8
# The lowest match score that still counts as evidence (0 to 1).
ANSWER_MIN_EVIDENCE_SCORE=0.2
# "Last month" and "this year" are worked out in this time zone.
TIMEZONE=Asia/Kolkata

# --- API -------------------------------------------------------------------------
# PROVISIONAL: requests per minute per user (per IP before sign-in), and as many again for
# a file's upload calls, which have their own bucket. The browser's polling and upload pace
# are sized under it (frontend/tests/request-budget.test.ts reads this line): keep it at 120
# or more, on the server too.
RATE_LIMIT_PER_MINUTE=120
# Chat questions per minute per user, beside the limit above (429 past it). Default 20.
CHAT_QUESTIONS_PER_MINUTE=20
LOG_LEVEL=INFO

# --- Search (PRD 3 V2, PROVISIONAL) ---------------------------------------------
# hnsw.ef_search: how many candidates the meaning index keeps while it walks
# (1 to 1000). Higher finds more of the true nearest pieces, slower.
SEARCH_EF=100

# Search inside documents (PRD 3 Q2): at most this many documents in one
# GET /api/search reply, 1 to 100.
SEARCH_MAX_DOCUMENTS=20

# Answers (PRD 3 Q4): the pieces on each side of an evidence piece also given to the draft, 0 to 3.
ANSWER_NEIGHBOURS=1
# Chat (PRD 3 H1): the question and answer pairs a follow-up is rewritten with, 0 (no rewrite) to 10.
CHAT_HISTORY_TURNS=3

# Council 4 Oct 2026 (PROVISIONAL): search an English question also in the script of its scans.
ANSWER_TRANSLATE_QUESTION=false
MODEL_TRANSLATE_TIMEOUT_SECONDS=20
# Ask speed (24 Oct 2026): a first question's rewrite and plan call ends within this many
# seconds (1 to 60); past it the question is answered without its plan. Optional: 4 when unset.
ANSWER_PLAN_TIMEOUT_SECONDS=4

# Council 5 Oct 2026 (PROVISIONAL): how each OCR page's DPI is chosen; fixed, text_height or text_height_no_scan_cap.
OCR_DPI_RULE=fixed

# PRD 5, the Gemini reader (section 9). OCR_ENGINE=gemini reads every scanned page with
# OCR_MODEL; laptops and CI keep OCR_ENGINE=rapidocr and MODEL_ENABLED=false, with no key.
OCR_MODEL=google/gemini-3.8-flash
# OpenRouter is the selected provider; keep the key in the server's .env only.
OPENROUTER_API_KEY=
# https only (plain http is accepted for localhost, 127.0.0.1 and ::1).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter's image detail shape supports low/high; thinking_level supports minimal/low/medium/high.
# Tushar (31 Oct 2026, #463): the operator console's Platform defaults and each organisation's AI
# settings can override these four; these are what is used where nothing is saved there.
OCR_MEDIA_RESOLUTION=high
# Tushar (16 Oct 2026): the default scanner is Gemini 3.8 Flash at high (high when unset).
OCR_THINKING_LEVEL=high
# "Read this page again" (F5) and Careful's re-reads read harder.
OCR_RETRY_MEDIA_RESOLUTION=high
OCR_RETRY_THINKING_LEVEL=high

# Mistral OCR (#473): the operator console may choose it, per organisation, to read scanned pages
# in place of Gemini. It can be chosen only with both set: the key (the server's .env only, never
# logged) and MISTRAL_ZDR_APPROVED=true.
# Set true only once Mistral has confirmed zero data retention for this account; without it Mistral keeps pages 30 days.
MISTRAL_API_KEY=
MISTRAL_ZDR_APPROVED=false
# Pages of one document read at a time; threads for RapidOCR work in each process (G8).
OCR_PAGE_CONCURRENCY=8
CPU_WORKERS=2
# Values of one document read again by the CPU checker (V1; was MAX_VISION_CROPS).
MAX_CHECK_CROPS=200
# Model calls a minute for the whole project (G9). The server sets 1200 (fast scan, 16 Oct 2026).
MODEL_RPM=1200
# Fast scan (16 Oct 2026): a Dynamic document of at most this many pages starts each page's
# whole-page Careful read with its first read; 0 never does. Cost saving (16 Oct 2026): 0, so a
# clear page pays for no second read and a page with a few hard words pays only for those;
# 2 is faster on 1 and 2 page documents and pays a whole careful read for each of their pages.
# Optional: 0 when unset.
CAREFUL_EARLY_MAX_PAGES=0
# Cost saving's limits (16 Oct 2026; optional, these are the defaults; tune with
# scripts/tune_cost_saving.py, measure with `python -m kaagaz.cli cost-saving`):
# a page is read again through its hard lines only when it has at most this many (1-60),
COST_SAVING_HARD_LINES_MAX=12
# and they are at most this share of its lines (0.05-1.0); else the whole page is read again.
COST_SAVING_HARD_SHARE=0.4
# Each hard line's crop reaches this many line heights past its sides (0.1-2.0).
COST_SAVING_CROP_PAD=0.5
# Routing each page by its content (#384; optional, these are the defaults). With true, an account
# may choose the reader "Save cost" in AI settings (#398; never with Cost saving switched off):
# each scanned page of its uploads is read by the local reader first and keeps that read when it is
# clean printed text; any doubt sends it to the model. Its values then need review (no second
# reader checks them). No account reads so unless it chooses to. With false, no account may choose
# it and one that did reads every page with the model.
PAGE_ROUTING=true
# A line read at least this sure by the local reader is clean (0.5-1.0).
PAGE_ROUTE_CLEAN_CONFIDENCE=0.95
# Fewer words than this on a page, or text lower than this many pixels, goes to the model.
PAGE_ROUTE_MIN_WORDS=8
PAGE_ROUTE_MIN_LINE_PX=16
# Line heights varying more than this (their coefficient of variation) look handwritten; more
# than this share of lines three or more to a row is a table: both go to the model.
PAGE_ROUTE_HEIGHT_SPREAD=0.45
PAGE_ROUTE_TABLE_SHARE=0.3
# A page with at most this many unsure lines (0-60, 0: never), and at most this share of its
# lines, has only those lines cut out, zoomed and read by the model (#385); at most
# PAGE_ROUTE_REGION_PAGES_MAX pages of a document are read so, the rest by the model whole.
PAGE_ROUTE_REGION_LINES_MAX=6
PAGE_ROUTE_REGION_SHARE=0.15
PAGE_ROUTE_REGION_PAGES_MAX=25
# A document's reading budget: this many seconds per page (1 page = 1 min, 30 pages = 30 min),
# never less than OCR_TIMEOUT_SECONDS: max(OCR_SECONDS_PER_PAGE x pages, OCR_TIMEOUT_SECONDS). Optional: 60 when unset.
OCR_SECONDS_PER_PAGE=60
# Minutes the reader may be down before pages are read locally and marked needs review (Q7).
READER_OUTAGE_FALLBACK_MINUTES=15

# PRD 5 bulk queue (Q1 to Q8). Optional: unset means the value shown here,
# except WORKER_REPLICAS, which is 3 on the server.
# Worker copies; the model rate is split across them.
WORKER_REPLICAS=1
# At most this many of one customer's documents are read at once (fair share).
MAX_ACTIVE_PER_CUSTOMER=2
# The express lane for short files; empty means one lane.
QUEUE_EXPRESS_URL=http://localhost:9324/000000000000/kaagaz-jobs-express
EXPRESS_MAX_PAGES=3
MAX_FILES_PER_BATCH=100

# PRD 5 context and memory (CX, M). Optional: unset means the value shown.
MODEL_CONTEXT_TOKENS=200000
# Answer from every piece when the scope fits this many tokens; 0 turns it off.
ANSWER_WHOLE_DOC_TOKENS=120000
# Faster Swift: a Swift (or Low) answer reads at most this many tokens of documents, whole
# documents or search evidence; Precision keeps the budget above. 0 turns the cap off.
ANSWER_SWIFT_INPUT_TOKENS=30000
# Read in parts (#381): a Precision answer whose evidence is more than this many tokens is read
# as parts at once (one model call a part, then one for the answer), so a fact in the middle of
# a long document is not missed. 0 turns it off; Swift never reads in parts.
ANSWER_PARTS_TOKENS=24000
# The most parts one answer reads (2 to 8), so the most extra model calls it makes.
ANSWER_PARTS_MAX=5
TOPIC_MAX_PER_DOC=40
TOPIC_EXPAND_MAX_PIECES=12
QUERY_ASPECTS_MAX=6
CHAT_SUMMARY_EVERY=6

# Model choice (council 11 Oct 2026): the OpenRouter providers page images may go to, comma
# separated. Optional: unset means google-vertex. Adding one (e.g. azure) is Vrushit's approval.
OPENROUTER_PROVIDERS=google-vertex
# Features 25-27: the model vendors (the part of a model id before "/") the operator may
# allow, comma separated. Optional: unset means google,anthropic,qwen,meta-llama (Tushar,
# 15 Oct 2026: Sonnet 5.5 is allowed by default; Tushar, 18 Oct 2026: Qwen and Llama too).
# A model of another vendor is never used.
OPENROUTER_MODEL_VENDORS=google,anthropic,qwen,meta-llama
