# Kaagaz-OCR settings. Copy this file to .env and adjust:
#   cp .env.example .env                 (bash)
#   Copy-Item .env.example .env          (PowerShell)
# Never commit .env.
#
# These values run everything on the laptop. docker-compose.yml swaps in the container
# hostnames (postgres, seaweedfs, temporal) for the app containers.

# Database: the postgres service in docker-compose.yml
POSTGRES_USER=kaagaz
POSTGRES_PASSWORD=kaagaz
POSTGRES_DB=kaagaz
DATABASE_URL=postgresql+asyncpg://kaagaz:kaagaz@localhost:5432/kaagaz

# File storage: SeaweedFS on the laptop, Amazon S3 in AWS.
# The access key must match infra/seaweedfs/s3.json.
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=kaagaz-local
S3_SECRET_KEY=kaagaz-local-secret
S3_REGION=us-east-1
S3_BUCKET=kaagaz-local
CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

# Workflow engine
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_URL=http://localhost:8233
TASK_QUEUE_CPU=cpu
TASK_QUEUE_GPU=gpu

# API
DEV_AUTH_SECRET=replace-with-a-long-random-string
MAX_UPLOAD_MB=50
PLACEHOLDER_STEP_SECONDS=3
LOG_LEVEL=INFO
