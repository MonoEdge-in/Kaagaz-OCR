# Keep LF line endings in the repo: the code runs in Linux containers, where CRLF breaks scripts.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.xlsx binary
*.xls binary
