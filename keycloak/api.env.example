# Copy to .env.keycloak. The local Compose overlay and docker-compose.prod.yml (the server) give this file to api only.
# Generate each value locally; do not reuse SESSION_SECRET or TOTP_ENCRYPTION_KEY.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=kaagaz-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_FLOW_ENCRYPTION_KEY=
# Change to true here only after Keycloak setup; keep shared .env false.
KEYCLOAK_ENABLED=false
# Server: Keycloak's address on the Docker network, so admin calls skip Caddy (which blocks /kc/admin).
# Leave empty on a laptop. On the test server: http://keycloak:8080/kc
KEYCLOAK_ADMIN_URL=
