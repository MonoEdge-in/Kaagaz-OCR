# Caddy in front of Kaagaz on the EC2 server (docker-compose.prod.yml). It gets and
# renews the Let's Encrypt certificate for KAAGAZ_DOMAIN, redirects HTTP to HTTPS,
# sends /api/* to the API unchanged and everything else to the Next.js server.
# Both values come from the server's .env; nothing secret is in this file.
{
	email {$ACME_EMAIL}
}

{$KAAGAZ_DOMAIN} {
	# Above the 100 MB upload limit; the API refuses a bigger file with its own message.
	request_body {
		max_size 110MB
	}

	# Browsers then use only HTTPS for this site for a year (security checklist, 15 Oct 2026).
	header Strict-Transport-Security "max-age=31536000"

	# A deploy restarts api and frontend (infra/ec2/deploy.sh, #246 A7). While one cannot be
	# reached, Caddy tries it again every half second for up to 30 s before giving up, so a
	# request waits through the restart instead of failing at once. Only requests that never
	# reached it are tried again, so nothing is sent twice.
	# Streaming Ask (POST /api/chat/stream, #535) replies text/event-stream, which Caddy flushes
	# as each event comes, so no flush_interval is needed. There is no encode (gzip) directive
	# here, which would hold the events back.
	handle /api/* {
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 500ms
			# An idle connection is closed here after 60 s, before uvicorn's own 75 s
			# (backend/Dockerfile), so Caddy never sends a request down one uvicorn just
			# closed, which was a 502 (A5). Caddy's default is 2 minutes.
			transport http {
				keepalive 60s
			}
		}
	}

	# Keycloak (company sign-in, #735), when it runs. Only the sign-in pages
	# (/kc/realms/<realm>/...) and their files (/kc/resources/) are served. The master realm
	# (Keycloak's own admin realm) and the admin console and API are never served from the
	# internet; admin work goes through kcadm.sh inside the container. If Keycloak is not
	# running, the error handler below answers.
	handle /kc/realms/master* {
		respond 404
	}
	# Nor is a realm's own account console (/kc/realms/<realm>/account): Kaagaz's menu opens the
	# password and authenticator pages through Keycloak's sign-in (#737).
	@keycloak_account path /kc/realms/*/account /kc/realms/*/account/*
	handle @keycloak_account {
		respond 404
	}
	@keycloak_pages path /kc/realms/* /kc/resources/*
	handle @keycloak_pages {
		reverse_proxy keycloak:8080
	}
	handle /kc/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:3000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# Still unreachable after that (a slow start, or a rollback): a short note and when to try
	# again, not a bare 502. Only Caddy's own errors land here; the API's own replies, 503s
	# included, pass through unchanged.
	handle_errors 502 503 504 {
		header Retry-After "60"
		respond "Kaagaz is updating. Please try again in a minute." 503
	}

	# One JSON line per request on stdout; the idle check reads these (WP-G). Never a
	# search, a question, a document's words or a folder's name (A18): these query
	# parameters are deleted from each logged address (q: /api/search, /api/documents,
	# the stories match, the /search and /chat pages; party: /api/documents; w: a page's
	# words; source_name: a folder upload's name; property: a survey number read from a document;
	# code and state: a Google sign-in's; hub.verify_token and hub.challenge: Meta's WhatsApp
	# webhook check, #603; key and session_code: Keycloak's emailed action links and login
	# steps; id_token_hint, login_hint and client_data: a Keycloak sign-out's ID token, a
	# sign-in's email and Keycloak's encoded return address, #735), and the Referer header, which repeats
	# a page's address, is not logged. The idle check reads only the path and the Cookie
	# header's name.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete q
					delete party
					delete w
					delete source_name
					delete property
					delete code
					delete state
					delete hub.verify_token
					delete hub.challenge
					delete key
					delete session_code
					delete id_token_hint
					delete login_hint
					delete client_data
				}
				request>headers>Referer delete
			}
		}
	}
}
