# Caddy in front of Kaagaz on the EC2 server (docker-compose.prod.yml). It gets and
# renews the Let's Encrypt certificate for KAAGAZ_DOMAIN, redirects HTTP to HTTPS,
# sends /api/* to the API unchanged and everything else to the Next.js server.
# Both values come from the server's .env; nothing secret is in this file.
{
	email {$ACME_EMAIL}
}

{$KAAGAZ_DOMAIN} {
	# Above the 50 MB upload limit; the API refuses a bigger file with its own message.
	request_body {
		max_size 60MB
	}

	# Browsers then use only HTTPS for this site for a year (security checklist, 15 Oct 2026).
	header Strict-Transport-Security "max-age=31536000"

	# A deploy restarts api and frontend (infra/ec2/deploy.sh, #246 A7). While one cannot be
	# reached, Caddy tries it again every half second for up to 30 s before giving up, so a
	# request waits through the restart instead of failing at once. Only requests that never
	# reached it are tried again, so nothing is sent twice.
	# Streaming Ask (POST /api/chat/stream, #535) replies text/event-stream, which Caddy flushes
	# as each event comes, so no flush_interval is needed. There is no encode (gzip) directive
	# here, which would hold the events back.
	handle /api/* {
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# Still unreachable after that (a slow start, or a rollback): a short note and when to try
	# again, not a bare 502. Only Caddy's own errors land here; the API's own replies, 503s
	# included, pass through unchanged.
	handle_errors 502 503 504 {
		header Retry-After "60"
		respond "Kaagaz is updating. Please try again in a minute." 503
	}

	# One JSON line per request on stdout; the idle check reads these (WP-G).
	log {
		output stdout
		format json
	}
}
