{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheKaagazDeployDocumentOnOnlyTheProductionServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-south-1:371892039688:instance/PRODUCTION_INSTANCE_ID",
        "arn:aws:ssm:ap-south-1:371892039688:document/Kaagaz-Deploy"
      ]
    },
    {
      "Sid": "ReadTheResult",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
