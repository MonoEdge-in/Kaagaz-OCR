{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubDeployJobsInTheProductionEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::371892039688:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:MonoEdge-in/Kaagaz-OCR:environment:production",
            "repo:MonoEdge-in/Kaagaz-OCR:environment:staging"
          ],
          "token.actions.githubusercontent.com:ref": [
            "refs/heads/deploy/production",
            "refs/heads/deploy/stage"
          ]
        }
      }
    }
  ]
}
