# Emails when a container is unhealthy or restarting (infra/ec2/containers-alert.sh,
# A22). Started by kaagaz-containers.timer. Copy to /etc/systemd/system/ (EC2 PRD
# section 9).
[Unit]
Description=Kaagaz: email when a container is unhealthy or restarting
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kaagaz
ExecStart=/home/ubuntu/kaagaz/infra/ec2/containers-alert.sh
