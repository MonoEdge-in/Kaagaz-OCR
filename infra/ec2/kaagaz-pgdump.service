# Writes the nightly database dump (infra/ec2/pgdump.sh). Started by
# kaagaz-pgdump.timer. Copy to /etc/systemd/system/ (EC2 PRD section 9).
[Unit]
Description=Kaagaz: nightly database dump
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kaagaz
ExecStart=/home/ubuntu/kaagaz/infra/ec2/pgdump.sh
