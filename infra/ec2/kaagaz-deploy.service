# Deploys the production branch (infra/ec2/deploy.sh). Started by
# kaagaz-deploy.timer. Copy to /etc/systemd/system/ (EC2 PRD section 9).
[Unit]
Description=Kaagaz: deploy the production branch
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kaagaz
# The first build takes several minutes, so no time limit.
TimeoutStartSec=infinity
# The read-only GitHub deploy key (EC2 PRD section 4).
Environment="GIT_SSH_COMMAND=ssh -i /home/ubuntu/.ssh/kaagaz_deploy -o IdentitiesOnly=yes"
ExecStart=/home/ubuntu/kaagaz/infra/ec2/deploy.sh
