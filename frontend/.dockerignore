# Kept out of the build context. `COPY . .` in the Dockerfile would otherwise send all of
# this to the builder, bust the cache on unrelated files, and could bake a local .env into
# the image.
.env
.env.*
node_modules
npm-debug.log*
*.tsbuildinfo
.next
out
coverage
.turbo
*.log
.DS_Store
Dockerfile
.dockerignore
