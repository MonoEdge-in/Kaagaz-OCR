# The OCR image: PaddleOCR-VL behind kaagaz.ocr_server.app (PRD 2 P1), for the `ocr`
# service in docker-compose.yml (`--profile paddle`). Only this image has the Paddle
# libraries, pinned by constraints-ocr.txt, and our own package goes in with --no-deps,
# so no database, storage or queue library is in it (security A4, A6).
#
# NOT BUILT on the build laptop (no Docker): every line marked VERIFY is unchecked.
#   docker compose --profile paddle build ocr      (downloads about 2 GB of weights)

# VERIFY: the digest is the tag's index digest from Docker Hub's API on 30 Sep 2026, not
# pulled here. Check it with: docker buildx imagetools inspect python:3.12.14-slim-trixie
FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

# VERIFY: OpenCV (in paddlex) loads libGL and GLib, as in backend/Dockerfile, and the
# paddlepaddle CPU wheel needs OpenMP (libgomp1).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgl1 libglib2.0-0t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# PyPI only, no --extra-index-url: the paddlepaddle 3.3.1 CPU wheel for cp312 is there (FINDINGS).
COPY constraints-ocr.txt ./
RUN pip install --constraint constraints-ocr.txt \
    "paddleocr[doc-parser]==3.7.0" "paddlex==3.7.2" "paddlepaddle==3.3.1" fastapi uvicorn pillow
COPY pyproject.toml ./
COPY kaagaz kaagaz
RUN pip install --no-deps .

# Security A4, A6: Hugging Face transformers would run the Python files that model folders
# carry, and the database, storage and queue libraries have no business here.
RUN python -c "import importlib.util as u; bad = [m for m in ('transformers', 'psycopg', 'boto3', 'sqlalchemy') if u.find_spec(m)]; assert not bad, bad"

# The weights at pinned revisions (FINDINGS), then sha256 checked: the sums are VERIFIED
# against the files the scratch venv downloaded at these revisions on 30 Sep. The models'
# own Python files are removed, so nothing in /opt/models can run, and it is read-only.
# VERIFY: that `hf` (huggingface-hub 1.33.0) runs here, and that PaddleOCR-VL loads with
# the .py files gone (the scratch run had them).
RUN hf download PaddlePaddle/PaddleOCR-VL-1.6 --revision c5630abae1d940eafe0697512a0325494b02ab42 \
        --local-dir /opt/models/PaddleOCR-VL-1.6 \
    && hf download PaddlePaddle/PP-DocLayoutV3 --revision 241f8bdfc77a7c7bee915a5057aaee58c235a8d3 \
        --local-dir /opt/models/PP-DocLayoutV3 \
    && printf '%s\n' \
        "85a479d506a11e724e7285d395c551be69f41dbc16b6342d3cacfb189aed71db  /opt/models/PaddleOCR-VL-1.6/model.safetensors" \
        "70bd316b0582769ec968829fd1feb1a6a58b7c941b938327e551b6b12b45c137  /opt/models/PP-DocLayoutV3/inference.pdiparams" \
        | sha256sum -c - \
    && rm -rf /opt/models/*/.cache \
    && find /opt/models -name "*.py" -delete \
    && chmod -R a-w /opt/models

# Offline from here on: VERIFIED in the scratch venv, where with these set the pipeline
# built and read a page with nothing downloaded. Paddle's cache and HOME live on the /tmp
# tmpfs, because compose makes the root file system read-only (security A5). No model is
# loaded at build time: the server loads it at start (minutes; /health says 503 till then).
ENV HF_HUB_OFFLINE=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_CACHE_HOME=/tmp/paddlex \
    HOME=/tmp

RUN useradd --uid 10001 --no-create-home --home-dir /tmp ocr
USER 10001

EXPOSE 8080
# One process and one page at a time; at most 4 connections open at once (security A5).
CMD ["uvicorn", "kaagaz.ocr_server.app:app", "--host", "0.0.0.0", "--port", "8080", \
     "--workers", "1", "--limit-concurrency", "4", "--no-access-log"]
