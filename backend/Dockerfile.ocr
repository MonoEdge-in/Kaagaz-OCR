# The OCR image: PaddleOCR-VL behind kaagaz.ocr_server.app (PRD 2 P1), for the `ocr`
# service in docker-compose.yml (`--profile paddle`). Only this image has the Paddle
# libraries, pinned by constraints-ocr.txt, and our own package goes in with --no-deps,
# so no database, storage or queue library is in it (security A4, A6).
#
# PADDLE_EXTRA picks the Paddle build: `paddle` (the default, the CPU) or `paddle-gpu`
# (CUDA 12.6, for docker-compose.gpu.yml, which sets it). The GPU wheel bundles nothing
# of CUDA itself: its nvidia-*-cu12 wheels come from PyPI and the driver from the host
# (NVIDIA Container Toolkit), so the base image is the same for both.
#
# NOT BUILT on the build laptop (no Docker): every line marked VERIFY is unchecked.
#   docker compose --profile paddle build ocr      (downloads about 2 GB of weights)
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile paddle build ocr

ARG PADDLE_EXTRA=paddle

# Stage 1, `pins`: the chosen extra's pins from pyproject.toml, written to
# /pins/<extra>.txt and nothing else. The main stage copies only that file, and Docker
# keys a COPY by the file's content, so a pyproject.toml change that leaves the extra's
# pins alone also leaves the Paddle install and the weights below cached (before, any
# pyproject.toml edit made a deploy reinstall the GPU packages: minutes and GBs of disk).
# The same base image as stage 2, so nothing new is pulled.
# VERIFY: the digest is the tag's index digest from Docker Hub's API on 30 Sep 2026, not
# pulled here. Check it with: docker buildx imagetools inspect python:3.12.14-slim-trixie
FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS pins
ARG PADDLE_EXTRA
WORKDIR /app
COPY pyproject.toml ./
RUN case "$PADDLE_EXTRA" in \
      paddle | paddle-gpu) \
        mkdir /pins \
        && python -c "import sys, tomllib; extras = tomllib.load(open('pyproject.toml', 'rb'))['project']['optional-dependencies']; print(*extras[sys.argv[1]], sep='\n')" "$PADDLE_EXTRA" > "/pins/$PADDLE_EXTRA.txt" ;; \
      *) \
        echo "PADDLE_EXTRA must be paddle or paddle-gpu, not: $PADDLE_EXTRA" >&2; exit 1 ;; \
    esac

# Stage 2, the image itself.
FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

# VERIFY: OpenCV (in paddlex) loads libGL and GLib, as in backend/Dockerfile, and the
# paddlepaddle CPU wheel needs OpenMP (libgomp1).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgl1 libglib2.0-0t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# PIP_DEFAULT_TIMEOUT and PIP_RETRIES: the GPU wheel (about 1 GB) comes from Paddle's CDN,
# which stalls from AWS Mumbai; pip's 15 s default read timeout failed a deploy on 4 Oct.
# A slow download now waits up to 2 minutes for data, and a dropped connection is tried
# again; the hashes are still checked, so a cut-off file still stops the build.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

WORKDIR /app

ARG PADDLE_EXTRA

# Never --extra-index-url: a second index can serve any package name (security A6).
# paddle (CPU): PyPI only, the paddlepaddle 3.3.1 CPU wheel for cp312 is there (FINDINGS).
# The paddle extra's list, read from pyproject.toml by the pins stage so its pins live in one
# place, and not `pip install .[paddle]`, which would also bring the backend's own dependencies
# (the database, storage and queue libraries checked for below). fastapi, uvicorn and pillow
# are the server's.
# constraints-ocr.txt pins every package that goes in.
# paddle-gpu: paddlepaddle-gpu 3.3.1 is not on PyPI. Step 1 installs that one wheel alone,
# by its direct URL on Paddle's cu126 index, sha256-checked, nothing else from there
# (paddle-gpu-wheel.txt). Step 2 installs everything else from PyPI, each file
# sha256-checked, exactly the list in constraints-ocr-gpu.txt (--no-deps: nothing more).
# Then pip check, and the paddle-gpu extra's pins (/pins/paddle-gpu.txt) are what went in.
# Anything else stops the build.
COPY constraints-ocr.txt constraints-ocr-gpu.txt paddle-gpu-wheel.txt ./
COPY --from=pins /pins /pins
RUN case "$PADDLE_EXTRA" in \
      paddle) \
        pip install --constraint constraints-ocr.txt --requirement /pins/paddle.txt fastapi uvicorn pillow ;; \
      paddle-gpu) \
        pip install --no-index --no-deps --require-hashes --requirement paddle-gpu-wheel.txt \
        && pip install --no-deps --require-hashes --index-url https://pypi.org/simple \
            --requirement constraints-ocr-gpu.txt \
        && pip check \
        && python -c "import importlib.metadata as m; pins = [p.split('==') for p in open('/pins/paddle-gpu.txt').read().splitlines()]; bad = [n for n, v in pins if m.version(n.split('[')[0]) != v]; assert pins and not bad, bad" ;; \
      *) \
        echo "PADDLE_EXTRA must be paddle or paddle-gpu, not: $PADDLE_EXTRA" >&2; exit 1 ;; \
    esac

# The weights at pinned revisions (FINDINGS), then sha256 checked: the sums are VERIFIED
# against the files the scratch venv downloaded at these revisions on 30 Sep. Licence: both
# are Apache-2.0 (their Hugging Face cards, read 30 Sep). The models' own Python files are
# removed, so nothing in /opt/models can run, and it is read-only. PaddleOCR-VL-1.6's four
# (configuration_, image_processing_, modeling_ and processing_paddleocr_vl.py) are for
# Hugging Face transformers' remote code; PaddleX builds the model and processor from its own
# classes and reads the weights, configs, tokenizer and chat template only (INFERRED from
# PaddleX's develop branch, inference/models/doc_vlm/predictor.py, not from 3.7.2 itself).
# VERIFY: that `hf` (huggingface-hub 1.33.0) runs here, and that PaddleOCR-VL loads with
# the .py files gone (the scratch run had them).
# Above COPY kaagaz, so a change to our own code reuses this layer instead of downloading
# the weights again (about 2 GB).
RUN hf download PaddlePaddle/PaddleOCR-VL-1.6 --revision c5630abae1d940eafe0697512a0325494b02ab42 \
        --local-dir /opt/models/PaddleOCR-VL-1.6 \
    && hf download PaddlePaddle/PP-DocLayoutV3 --revision 241f8bdfc77a7c7bee915a5057aaee58c235a8d3 \
        --local-dir /opt/models/PP-DocLayoutV3 \
    && printf '%s\n' \
        "85a479d506a11e724e7285d395c551be69f41dbc16b6342d3cacfb189aed71db  /opt/models/PaddleOCR-VL-1.6/model.safetensors" \
        "70bd316b0582769ec968829fd1feb1a6a58b7c941b938327e551b6b12b45c137  /opt/models/PP-DocLayoutV3/inference.pdiparams" \
        | sha256sum -c - \
    && rm -rf /opt/models/*/.cache \
    && find /opt/models -name "*.py" -delete \
    && chmod -R a-w /opt/models

# pyproject.toml only now, for our own package: after the weights, like our code.
COPY pyproject.toml ./
COPY kaagaz kaagaz
RUN pip install --no-deps .

# Security A4, A6: Hugging Face transformers would run the Python files that model folders
# carry, and the database, storage and queue libraries have no business here.
RUN python -c "import importlib.util as u; bad = [m for m in ('transformers', 'psycopg', 'boto3', 'sqlalchemy') if u.find_spec(m)]; assert not bad, bad"

# One Paddle build only, the one PADDLE_EXTRA asked for: the CPU paddlepaddle is never in
# the GPU image (both install the same `paddle` module, so one would overwrite the other),
# and the GPU image carries the CUDA libraries (nvidia-cudnn-cu12). Package names only:
# importing the GPU paddle needs the NVIDIA driver (libcuda.so.1), which a build never has
# (seen on the g4dn's first GPU build, 4 Oct 2026). The ocr server checks that paddle is
# built for CUDA when it loads on a GPU (PaddleModel.load).
RUN python -c "import importlib.metadata as m, os; gpu = os.environ['PADDLE_EXTRA'] == 'paddle-gpu'; names = {d.metadata['Name'].lower().replace('_', '-') for d in m.distributions()}; assert ('paddlepaddle' in names, 'paddlepaddle-gpu' in names) == (not gpu, gpu), sorted(names); assert ('nvidia-cudnn-cu12' in names) == gpu, sorted(names)"

# Offline from here on: VERIFIED in the scratch venv, where with these set the pipeline
# built and read a page with nothing downloaded. Paddle's cache and HOME live on the /tmp
# tmpfs, because compose makes the root file system read-only (security A5). No model is
# loaded at build time: the server loads it at start (minutes; /health says 503 till then).
ENV HF_HUB_OFFLINE=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_CACHE_HOME=/tmp/paddlex \
    HOME=/tmp

RUN useradd --uid 10001 --no-create-home --home-dir /tmp ocr
USER 10001

EXPOSE 8080
# One process and one page at a time; at most 4 connections open at once (security A5).
CMD ["uvicorn", "kaagaz.ocr_server.app:app", "--host", "0.0.0.0", "--port", "8080", \
     "--workers", "1", "--limit-concurrency", "4", "--no-access-log"]
